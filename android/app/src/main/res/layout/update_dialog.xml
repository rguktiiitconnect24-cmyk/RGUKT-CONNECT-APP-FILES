<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/update_dialog_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bottom_sheet_glass_bg"
    android:clickable="false"
    android:focusable="false"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Handle - Decorative only -->
    <View
        android:id="@+id/dialog_handle"
        android:layout_width="50dp"
        android:layout_height="5dp"
        android:background="#E5E7EB"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:clickable="false"
        android:focusable="false" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:clipToPadding="false"
        android:paddingBottom="32dp"
        app:layout_constraintTop_toBottomOf="@id/dialog_handle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:clickable="false"
        android:focusable="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="32dp"
            android:clickable="false"
            android:focusable="false"
            android:clipChildren="false"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/header_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="false"
                android:focusable="false">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    app:cardCornerRadius="50dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:strokeWidth="0dp"
                    android:layout_marginBottom="24dp"
                    android:clickable="false"
                    android:focusable="false">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clickable="false"
                        android:focusable="false">
                        <View android:id="@+id/icon_bg_pulse_outer" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/circle_pulse_bg" android:alpha="0.08" android:clickable="false" android:focusable="false"/>
                        <View android:id="@+id/icon_bg_pulse_mid" android:layout_width="75dp" android:layout_height="75dp" android:layout_gravity="center" android:background="@drawable/circle_pulse_bg" android:alpha="0.12" android:clickable="false" android:focusable="false"/>
                        <View android:id="@+id/icon_bg_pulse_inner" android:layout_width="60dp" android:layout_height="60dp" android:layout_gravity="center" android:background="@drawable/icon_gradient_bg" android:clickable="false" android:focusable="false"/>
                        <ImageView android:id="@+id/download_icon_animated" android:layout_width="28dp" android:layout_height="28dp" android:layout_gravity="center" android:src="@android:drawable/stat_sys_download" app:tint="#FFFFFF" android:clickable="false" android:focusable="false"/>
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Update Required"
                    android:textColor="#4F46E5"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.25"
                    android:textAllCaps="true"
                    android:gravity="center"
                    android:layout_marginBottom="8dp"
                    android:clickable="false"
                    android:focusable="false"/>

                <TextView
                    android:id="@+id/update_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="New Features Ready"
                    android:textColor="#111827"
                    android:textSize="26sp"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:clickable="false"
                    android:focusable="false"/>

                <TextView
                    android:id="@+id/version_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="v2.3"
                    android:textColor="#9CA3AF"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:clickable="false"
                    android:focusable="false"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/changelog_container_bg"
                android:padding="28dp"
                android:orientation="vertical"
                android:layout_marginTop="36dp"
                android:layout_marginBottom="40dp"
                android:clickable="false"
                android:focusable="false">

                <TextView
                    android:id="@+id/update_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="We have added premium features and optimized the application for better performance."
                    android:textColor="#4B5563"
                    android:textSize="15sp"
                    android:lineSpacingExtra="8dp"
                    android:gravity="center"
                    android:clickable="false"
                    android:focusable="false"/>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_update"
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:minHeight="48dp"
                android:minWidth="48dp"
                android:text="Update Now"
                android:textAllCaps="false"
                android:textSize="18sp"
                android:fontFamily="sans-serif-black"
                app:cornerRadius="24dp"
                android:backgroundTint="#4F46E5"
                android:textColor="#FFFFFF"
                android:elevation="12dp"
                app:elevation="12dp"
                android:clickable="true"
                android:focusable="true"
                android:stateListAnimator="@null"/>

            <TextView
                android:id="@+id/bottom_info_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="This update is essential for app stability"
                android:textColor="#9CA3AF"
                android:textSize="11sp"
                android:gravity="center"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-medium"
                android:clickable="false"
                android:focusable="false"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
