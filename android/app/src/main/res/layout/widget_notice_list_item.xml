<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#1AFFFFFF"
    android:padding="12dp">

    <!-- Priority Strip -->
    <View
        android:id="@+id/v_priority_strip"
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:layout_alignParentStart="true"
        android:layout_alignTop="@id/tv_notice_title"
        android:layout_alignBottom="@id/tv_notice_time"
        android:layout_marginEnd="12dp"
        android:background="@drawable/widget_priority_blue" />

    <!-- Notice Title -->
    <TextView
        android:id="@+id/tv_notice_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/v_priority_strip"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="2"
        android:text="Notice Title"
        android:textColor="#FFFFFF"
        android:textSize="14sp" />

    <!-- Notice Category and Time -->
    <TextView
        android:id="@+id/tv_notice_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/tv_notice_title"
        android:layout_toEndOf="@id/v_priority_strip"
        android:layout_marginTop="4dp"
        android:text="2 hours ago"
        android:textColor="#80FFFFFF"
        android:textSize="11sp"
        android:fontFamily="sans-serif" />

</RelativeLayout>
