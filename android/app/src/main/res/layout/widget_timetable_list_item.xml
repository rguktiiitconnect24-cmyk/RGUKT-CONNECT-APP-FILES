<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp">

    <!-- Timeline Dot/Strip -->
    <View
        android:id="@+id/v_timeline_dot"
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:layout_alignParentStart="true"
        android:layout_alignTop="@id/tv_class_title"
        android:layout_alignBottom="@id/tv_class_time"
        android:layout_marginEnd="12dp"
        android:background="@drawable/widget_priority_blue" />

    <!-- Class Title -->
    <TextView
        android:id="@+id/tv_class_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/v_timeline_dot"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:text="Mathematics"
        android:textColor="#FFFFFF"
        android:textSize="14sp" />

    <!-- Class Time and Room -->
    <TextView
        android:id="@+id/tv_class_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/tv_class_title"
        android:layout_toEndOf="@id/v_timeline_dot"
        android:layout_marginTop="2dp"
        android:text="9:30 AM - Room 205"
        android:textColor="#80FFFFFF"
        android:textSize="12sp"
        android:fontFamily="sans-serif" />

</RelativeLayout>
